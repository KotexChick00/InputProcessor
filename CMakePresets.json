{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug (system dependencies)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (system dependencies)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-msvc",
      "hidden": true,
      "description": "Force MSVC so stray MinGW/Perl compilers on PATH are never picked up.",
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "vcpkg-debug",
      "displayName": "Debug (vcpkg, MSVC)",
      "inherits": [ "windows-msvc", "debug" ],
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vcpkg-release",
      "displayName": "Release (vcpkg, MSVC)",
      "inherits": [ "windows-msvc", "release" ],
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "vcpkg-debug", "configurePreset": "vcpkg-debug", "configuration": "Debug" },
    { "name": "vcpkg-release", "configurePreset": "vcpkg-release", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "vcpkg-debug", "configurePreset": "vcpkg-debug", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "vcpkg-release", "configurePreset": "vcpkg-release", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
